        </xarm6/Geometry/world/link_base/link1/link2/link3/link4/link5/link6/link_eef/xarm_gripper_base_link/right_inner_knuckle>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "world"
        {
            over "link_base"
            {
                over "link1"
                {
                    over "link2"
                    {
                        over "link3"
                        {
